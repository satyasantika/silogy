# SILOGY — Template .env PRODUKSI (Docker Compose di VPS).
# Salin ke `.env` di server lalu isi semua nilai <...>. JANGAN commit .env asli.
#
#   cp .env.production.example .env
#   docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
#   # tempel hasilnya ke APP_KEY di bawah

APP_NAME=SILOGY
APP_ENV=production
APP_KEY=                              # base64:... (generate, lihat di atas)
APP_DEBUG=false
APP_URL=https://silogy.unsil.ac.id    # ganti dengan domain produksi Anda
# Untuk deploy subpath (mis. https://supportfkip.unsil.ac.id/demo-silogy),
# cukup sertakan path di APP_URL — SESSION_PATH otomatis mengikuti.

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Port host (di-bind ke docker0 gateway 172.17.0.1) yang di-route
# silaris-frontend nginx → container nginx silogy. 8081 bebas di server ns93.
APP_PORT=8081

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ── Database (dipakai Laravel & docker-compose.prod.yml) ──
DB_CONNECTION=mysql
DB_HOST=mysql                         # nama service compose, JANGAN 127.0.0.1
DB_PORT=3306
DB_DATABASE=silogy_prod
DB_USERNAME=silogy
DB_PASSWORD=<password-db-kuat>
DB_ROOT_PASSWORD=<password-root-db-kuat>   # dipakai compose untuk MYSQL_ROOT_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Redis ──
# phpredis (ekstensi C, sudah di-bundle di Dockerfile.prod) lebih cepat dari
# predis untuk produksi. Ganti ke predis hanya bila ekstensi tak tersedia.
REDIS_CLIENT=phpredis
REDIS_HOST=redis                      # nama service compose
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true            # wajib true di HTTPS produksi
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Email (SMTP asli) ──
MAIL_MAILER=smtp
MAIL_HOST=smtp.unsil.ac.id
MAIL_PORT=587
MAIL_USERNAME=silogy
MAIL_PASSWORD=<password-smtp>
MAIL_FROM_ADDRESS=silogy@unsil.ac.id
MAIL_FROM_NAME="${APP_NAME}"

# ── Google Gemini (modul AI) ──
GEMINI_API_KEY=<api-key-gemini>
GEMINI_MODEL_DEFAULT=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MAX_TOKENS=4096
GEMINI_MONTHLY_TOKEN_BUDGET=5000000

# ── Integrasi akademik UNSIL (opsional) ──
SINTESYS_API_ENDPOINT=https://api-sintesys.unsil.io/api/akademik/detail_nilai
SINTESYS_API_TOKEN=<token-sintesys>
SIMAK_API_ENDPOINT=
SIMAK_API_TOKEN=

VITE_APP_NAME="${APP_NAME}"
