APP_NAME=SILOGY
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8008
# Contoh untuk deployment di subpath (mis. produksi):
# APP_URL=https://supportfkip.unsil.ac.id/demo-silogy
# ASSET_URL=https://supportfkip.unsil.ac.id/demo-silogy

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=silogy
DB_USERNAME=silogy
DB_PASSWORD=silogy

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Contoh untuk deployment di subpath (mis. produksi):
# SESSION_COOKIE=silogy_session
# SESSION_PATH=/demo-silogy
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis = tanpa ekstensi PHP redis (umum di Windows). phpredis = perlu ekstensi Redis untuk PHP.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit lokal (UI: http://127.0.0.1:8025, SMTP: port 1025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="silogy@unsil.test"
MAIL_FROM_NAME="${APP_NAME}"
# Alternatif dev tanpa Mailpit: MAIL_MAILER=log (email masuk storage/logs/laravel.log)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Gemini API (modul AI — Sprint 6)
# Daftar API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MAX_TOKENS=4096
GEMINI_MONTHLY_TOKEN_BUDGET=5000000

# API Sintesys (impor kelas MK + peserta — semester ≥ 20251)
SINTESYS_API_ENDPOINT=https://api-sintesys.unsil.io/api/akademik/detail_nilai
SINTESYS_API_TOKEN=

# API Simak (impor kelas MK + peserta — semester ≤ 20242)
SIMAK_API_ENDPOINT=
SIMAK_API_TOKEN=

VITE_APP_NAME="${APP_NAME}"
